# ==========================================
# PharmaRCA Environment Configuration
# ==========================================

# Groq API Key (Get free key at: https://console.groq.com/keys)
# Supported models: llama-3.3-70b-versatile, gemma2-9b-it
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration
# Default SQLite (Instant, zero-setup out of the box):
DATABASE_URL=sqlite:///./rca_database.db

# If using PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/rca_db

# If using MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/rca_db
